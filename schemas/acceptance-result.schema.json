{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["verdict", "reason", "checks", "evidence", "constitution_verdict", "suggested_children"],
  "additionalProperties": false,
  "properties": {
    "verdict": { "type": "string", "enum": ["pass", "repair", "blocked", "visual_uncertain"] },
    "reason": { "type": "string" },
    "checks": { "type": "array", "items": { "type": "string" } },
    "evidence": { "type": "array", "items": { "type": "string" } },
    "constitution_verdict": {
      "type": "string",
      "enum": ["within_bounds", "below_floor", "above_ceiling", "not_checked"]
    },
    "suggested_children": {
      "type": "array",
      "items": { "$ref": "#/$defs/childTask" }
    }
  },
  "$defs": {
    "childTask": {
      "type": "object",
      "required": [
        "title",
        "description",
        "scope",
        "acceptance",
        "depends_on",
        "coverage_ids",
        "verification_kind",
        "estimated_leaf"
      ],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "scope": { "type": "array", "items": { "type": "string" } },
        "acceptance": { "type": "array", "items": { "type": "string" } },
        "depends_on": { "type": "array", "items": { "type": "string" } },
        "coverage_ids": { "type": "array", "items": { "type": "string" } },
        "verification_kind": { "type": "string" },
        "estimated_leaf": { "type": "boolean" }
      }
    }
  }
}
