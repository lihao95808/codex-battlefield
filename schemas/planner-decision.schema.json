{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "decision",
    "reason",
    "children",
    "risks",
    "leaf_certainty",
    "why_not_leaf",
    "coverage_ids",
    "integration_plan",
    "verification_plan"
  ],
  "additionalProperties": false,
  "properties": {
    "decision": { "type": "string", "enum": ["execute", "decompose", "blocked", "repair"] },
    "reason": { "type": "string" },
    "children": {
      "type": "array",
      "items": { "$ref": "#/$defs/childTask" }
    },
    "risks": { "type": "array", "items": { "type": "string" } },
    "leaf_certainty": { "type": "string", "enum": ["300%", "not_sure"] },
    "why_not_leaf": { "type": "string" },
    "coverage_ids": { "type": "array", "items": { "type": "string" } },
    "integration_plan": { "type": "string" },
    "verification_plan": { "type": "string" }
  },
  "$defs": {
    "childTask": {
      "type": "object",
      "required": [
        "title",
        "description",
        "scope",
        "acceptance",
        "depends_on",
        "coverage_ids",
        "verification_kind",
        "estimated_leaf"
      ],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "scope": { "type": "array", "items": { "type": "string" } },
        "acceptance": { "type": "array", "items": { "type": "string" } },
        "depends_on": { "type": "array", "items": { "type": "string" } },
        "coverage_ids": { "type": "array", "items": { "type": "string" } },
        "verification_kind": { "type": "string" },
        "estimated_leaf": { "type": "boolean" }
      }
    }
  }
}
