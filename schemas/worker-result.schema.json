{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["status", "summary", "changed_files", "tests", "evidence", "risks", "suggested_children"],
  "additionalProperties": false,
  "properties": {
    "status": { "type": "string", "enum": ["succeeded", "failed", "blocked", "needs_decomposition"] },
    "summary": { "type": "string" },
    "changed_files": { "type": "array", "items": { "type": "string" } },
    "tests": { "type": "array", "items": { "type": "string" } },
    "evidence": { "type": "array", "items": { "type": "string" } },
    "risks": { "type": "array", "items": { "type": "string" } },
    "suggested_children": {
      "type": "array",
      "items": { "$ref": "#/$defs/childTask" }
    }
  },
  "$defs": {
    "childTask": {
      "type": "object",
      "required": [
        "title",
        "description",
        "scope",
        "acceptance",
        "depends_on",
        "coverage_ids",
        "verification_kind",
        "estimated_leaf"
      ],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "scope": { "type": "array", "items": { "type": "string" } },
        "acceptance": { "type": "array", "items": { "type": "string" } },
        "depends_on": { "type": "array", "items": { "type": "string" } },
        "coverage_ids": { "type": "array", "items": { "type": "string" } },
        "verification_kind": { "type": "string" },
        "estimated_leaf": { "type": "boolean" }
      }
    }
  }
}
